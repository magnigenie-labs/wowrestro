			await page.waitForTimeout(120); // Deliberately expose rerenders between individual keystrokes.
			expected += key === ',' ? '.' : key;
			assert(await locator.inputValue() === expected, 'Keystroke lost while typing ' + JSON.stringify(value) + ': expected ' + expected);
		}
